#!name=Instagram Media Download
#!desc=在 Safari 打开 Instagram 帖子/Reels 页面时注入下载按钮
#!author=danielwu2020
#!homepage=https://www.instagram.com
#!icon=https://www.instagram.com/static/images/ico/favicon-192.png

[Script]
http-response ^https?:\/\/(www\.)?instagram\.com\/(p|reel|tv)\/[^\/\?\#]+\/?.* script-path=https://raw.githubusercontent.com/danielwu2020/loon-plugin/main/ig_download.js, requires-body=true, timeout=20, tag=Instagram Media Download

[MITM]
hostname = www.instagram.com, instagram.com
