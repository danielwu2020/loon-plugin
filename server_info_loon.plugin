[Script]
generic script-path=https://raw.githubusercontent.com/danielwu2020/loon-plugin/main/server_info_loon.js, argument="ipqs=你的IPQS_KEY&abuse=你的ABUSEIPDB_KEY&debug=1", tag=节点详情查询 Pro, img-url=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/apps/ipInfo.png, enable=true