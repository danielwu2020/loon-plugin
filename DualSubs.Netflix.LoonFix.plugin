#!name = 🍿️ DualSubs: 🇳 Netflix (Loon Fix v2)
#!desc = Netflix 双语翻译字幕｜跳过过大的 OCA 响应，保留字幕文本翻译
#!author = @VirgilClyne / compatibility patch
#!homepage = https://dualsubs.github.io/guide/netflix
#!system = iOS,iPadOS,macOS,tvOS
#!system_version = 15

# Loon 3.5.2 测试修正版
# 核心思路：
# - 不使用 binary-body-mode，避免 DualSubs Translate 脚本拿到 Uint8Array 后无法按字幕文本处理。
# - 使用旧版 http-response 语法的 max-size=65536，
#   尝试跳过较大的 Netflix OCA 音视频分块，只处理较小的字幕响应。
# - 关闭原版 DualSubs Netflix 后再启用本插件，避免重复匹配。

[Script]
http-response ^https?:\/\/(.+)\.oca\.nflxvideo\.net\/\?o=\d+&v=\d+&e=\d+&t=.+ script-path=https://github.com/DualSubs/Universal/releases/latest/download/Translate.response.bundle.js,requires-body=true,max-size=65536,tag=🍿️ DualSubs.Netflix.Translate.Subtitles.response

[Mitm]
hostname = %APPEND% *.nflxvideo.net
